# Public client configuration only. This build refuses cloud mode.
VITE_PORTAL_MODE=emulator
# Future owner-reviewed public Firebase web app configuration; no real values needed locally.
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0948635471
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_MI_TENANT_ID=
# NEVER put Microsoft client secrets, SMTP passwords, OTP peppers or private keys in VITE_*.
# Private backend configuration is described in docs/oauth-owner-setup.md, not bundled here.

# Phase 2.5: use node scripts/configure-cloud-test.mjs to create ignored .env.cloud-test.local.
# That build uses VITE_PORTAL_MODE=cloud-test, VITE_REAL_COLLECTION_ENABLED=false,
# exact public app config, VITE_MI_TENANT_ID and public VITE_APPCHECK_SITE_KEY.
# VITE_APPCHECK_SITE_KEY is the public Fraud Defense / reCAPTCHA Enterprise Web Key ID.
# No Classic secret or service-account key belongs here. No mode accepts real SIN collection.
