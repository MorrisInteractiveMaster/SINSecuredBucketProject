rules_version = '2';
// SYNTHETIC CLOUD TEST PROTOTYPE. Deploy ONLY to database mi-sin-portal.
// No direct client reads, queries or mutations, including roles and ciphertext.
// The single trusted callable enforces identity/schema/state checks; its runtime IAM
// must be conditionally scoped to this named database. Admin SDK bypasses Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {allow read, write: if false;}
  }
}
